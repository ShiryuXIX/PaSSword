rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidRecoveryKey(recoveryData) {
      return recoveryData.keys().hasAll(['version', 'key'])
        && recoveryData.keys().hasOnly(['version', 'key'])
        && recoveryData.version == 1
        && recoveryData.key is string
        && recoveryData.key.matches('^[A-Za-z0-9+/]{43}=$');
    }

    function hasValidVaultMetadata() {
      return request.resource.data.keys().hasAll([
          'version',
          'kdf',
          'iterations',
          'salt',
          'verifier'
        ])
        && request.resource.data.keys().hasOnly([
          'version',
          'kdf',
          'iterations',
          'keyGeneration',
          'rotationInProgress',
          'rotationId',
          'salt',
          'verifier'
        ])
        && request.resource.data.version == 1
        && (
          (
            request.resource.data.kdf == 'PBKDF2-SHA-256'
            && request.resource.data.iterations == 600000
          )
          || (
            request.resource.data.kdf == 'RANDOM-AES-256'
            && request.resource.data.iterations == 0
          )
        )
        && (
          !request.resource.data.keys().hasAny(['keyGeneration'])
          || (
            request.resource.data.keyGeneration is int
            && request.resource.data.keyGeneration >= 1
            && request.resource.data.keyGeneration <= 2147483647
          )
        )
        && (
          !request.resource.data.keys().hasAny(['rotationInProgress'])
          || request.resource.data.rotationInProgress is bool
        )
        && (
          !request.resource.data.keys().hasAny(['rotationId'])
          || (
            request.resource.data.rotationId is string
            && request.resource.data.rotationId.size() == 36
          )
        )
        && request.resource.data.salt is string
        && request.resource.data.salt.size() == 24
        && request.resource.data.verifier is map
        && request.resource.data.verifier.keys().hasAll(['iv', 'ciphertext'])
        && request.resource.data.verifier.keys().hasOnly(['iv', 'ciphertext'])
        && request.resource.data.verifier.iv is string
        && request.resource.data.verifier.iv.size() == 16
        && request.resource.data.verifier.ciphertext is string
        && request.resource.data.verifier.ciphertext.size() >= 24
        && request.resource.data.verifier.ciphertext.size() <= 512;
    }

    function isLegacyRotationLockCleanup() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return hasValidVaultMetadata()
        && changedKeys.hasOnly(['rotationInProgress', 'rotationId'])
        && changedKeys.hasAny(['rotationInProgress', 'rotationId'])
        && resource.data.rotationInProgress == true
        && request.resource.data.rotationInProgress == false
        && !request.resource.data.keys().hasAny(['rotationId']);
    }

    function hasCurrentKeyGeneration(uid) {
      let metadataPath = /databases/$(database)/documents/users/$(uid)/vault/meta;
      let metadata = getAfter(metadataPath).data;
      let activeGeneration = metadata.keys().hasAny(['keyGeneration'])
        ? metadata.keyGeneration
        : 1;
      return (
        !metadata.keys().hasAny(['rotationInProgress'])
        || metadata.rotationInProgress != true
      )
        && (
          request.resource.data.keys().hasAny(['keyGeneration'])
            ? request.resource.data.keyGeneration is int
              && request.resource.data.keyGeneration == activeGeneration
            : activeGeneration == 1
        );
    }

    function hasNoRotationInProgress(uid) {
      let metadataPath = /databases/$(database)/documents/users/$(uid)/vault/meta;
      let metadata = getAfter(metadataPath).data;
      return !metadata.keys().hasAny(['rotationInProgress'])
        || metadata.rotationInProgress != true;
    }

    function hasValidEncryptedCredential(uid) {
      return request.resource.data.keys().hasAll([
          'version',
          'iv',
          'ciphertext'
        ])
        && request.resource.data.keys().hasOnly([
          'version',
          'keyGeneration',
          'iv',
          'ciphertext'
        ])
        && request.resource.data.version == 1
        && hasCurrentKeyGeneration(uid)
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() >= 24
        && request.resource.data.ciphertext.size() <= 20000;
    }

    match /users/{uid}/vault/meta {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !exists(/databases/$(database)/documents/users/$(uid)/vault/meta)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/vault/recovery)
        && hasValidRecoveryKey(
          getAfter(/databases/$(database)/documents/users/$(uid)/vault/recovery).data
        )
        && hasValidVaultMetadata()
        && (
          !request.resource.data.keys().hasAny(['rotationInProgress'])
          || request.resource.data.rotationInProgress != true
        )
        && !request.resource.data.keys().hasAny(['rotationId']);
      allow update: if isOwner(uid) && isLegacyRotationLockCleanup();
      allow delete: if false;
    }

    match /users/{uid}/vault/recovery {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !exists(/databases/$(database)/documents/users/$(uid)/vault/recovery)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/vault/meta)
        && hasValidRecoveryKey(request.resource.data);
      allow update, delete: if false;
    }

    match /users/{uid}/credentials/{credentialId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasValidEncryptedCredential(uid);
      allow delete: if isOwner(uid) && hasNoRotationInProgress(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
